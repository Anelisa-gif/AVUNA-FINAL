<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Customer_master.Master.cs" Inherits="AVUNA_COLLECTIVE.Customer_master" %>
<%@ Import Namespace="System.Collections.Generic" %>
<%@ Import Namespace="System.Configuration" %>
<%@ Import Namespace="System.Data.SqlClient" %>
<%@ Import Namespace="System.Globalization" %>
<%@ Import Namespace="System.Text" %>
<script runat="server">
    // Gives the Avuna Assistance chatbot the signed-in customer's OWN orders, so it can answer
    // "how much do I owe?" and "where is ORD003?" accurately. Balance rules match the dashboard.
    protected string AvaOrdersJson()
    {
        try
        {
            object cid = HttpContext.Current.Session["customer_ID"];
            int id;
            if (cid == null || !Int32.TryParse(Convert.ToString(cid), out id) || id < 1) return "{\"ok\":false,\"orders\":[]}";

            var ids = new List<string>(); var dates = new List<string>(); var states = new List<string>(); var totals = new List<decimal>();
            var paid = new Dictionary<string, decimal>(StringComparer.OrdinalIgnoreCase);
            using (var conn = new SqlConnection(ConfigurationManager.ConnectionStrings["GroupWst2"].ConnectionString))
            {
                conn.Open();
                using (var cmd = new SqlCommand("SELECT order_ID, order_Date, order_Status, order_TotalCost FROM [Order] WHERE customer_ID = @id ORDER BY order_Date DESC, order_ID DESC", conn))
                {
                    cmd.Parameters.AddWithValue("@id", id);
                    using (var r = cmd.ExecuteReader())
                        while (r.Read())
                        {
                            ids.Add(Convert.ToString(r.GetValue(0)).Trim());
                            dates.Add(r.IsDBNull(1) ? "-" : Convert.ToDateTime(r.GetValue(1), CultureInfo.InvariantCulture).ToString("d MMM yyyy", CultureInfo.InvariantCulture));
                            states.Add(r.IsDBNull(2) ? "" : Convert.ToString(r.GetValue(2)).Trim());
                            totals.Add(r.IsDBNull(3) ? 0m : Convert.ToDecimal(r.GetValue(3), CultureInfo.InvariantCulture));
                        }
                }
                using (var cmd = new SqlCommand("SELECT p.order_ID, p.payment_Amount, p.payment_Status FROM Payment p INNER JOIN [Order] o ON o.order_ID = p.order_ID WHERE o.customer_ID = @id", conn))
                {
                    cmd.Parameters.AddWithValue("@id", id);
                    using (var r = cmd.ExecuteReader())
                        while (r.Read())
                        {
                            string ps = r.IsDBNull(2) ? "" : Convert.ToString(r.GetValue(2)).ToLowerInvariant();
                            bool ok = !(ps.Contains("unpaid") || ps.Contains("not paid") || ps.Contains("pend") || ps.Contains("fail") || ps.Contains("declin") || ps.Contains("cancel") || ps.Contains("refund") || ps.Contains("overdue") || ps.Contains("await") || ps.Contains("partial"))
                                      && (ps.Contains("paid") || ps.Contains("complet") || ps.Contains("success") || ps.Contains("receiv") || ps.Contains("approved"));
                            if (!ok) continue;
                            string key = Convert.ToString(r.GetValue(0)).Trim();
                            decimal amt = r.IsDBNull(1) ? 0m : Convert.ToDecimal(r.GetValue(1), CultureInfo.InvariantCulture);
                            decimal cur; paid.TryGetValue(key, out cur); paid[key] = cur + amt;
                        }
                }
            }

            var sb = new StringBuilder("{\"ok\":true,\"orders\":[");
            for (int i = 0; i < ids.Count; i++)
            {
                decimal p; paid.TryGetValue(ids[i], out p);
                bool cancelled = states[i].ToLowerInvariant().Contains("cancel");
                decimal bal = cancelled ? 0m : Math.Max(0m, totals[i] - p);
                if (i > 0) sb.Append(",");
                sb.Append("{\"id\":\"").Append(HttpUtility.JavaScriptStringEncode(ids[i])).Append("\",\"date\":\"").Append(HttpUtility.JavaScriptStringEncode(dates[i]))
                  .Append("\",\"status\":\"").Append(HttpUtility.JavaScriptStringEncode(states[i])).Append("\",\"total\":").Append(totals[i].ToString("0.00", CultureInfo.InvariantCulture))
                  .Append(",\"paid\":").Append(p.ToString("0.00", CultureInfo.InvariantCulture)).Append(",\"balance\":").Append(bal.ToString("0.00", CultureInfo.InvariantCulture))
                  .Append(",\"cancelled\":").Append(cancelled ? "true" : "false").Append("}");
            }
            return sb.Append("]}").ToString();
        }
        catch (Exception)
        {
            return "{\"ok\":false,\"orders\":[]}";
        }
    }
</script>
<!DOCTYPE html>
<html lang="en">
<head runat="server">
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%: Page.Title %> - Avuna Collective</title>
    <asp:PlaceHolder runat="server">
        <%: Scripts.Render("~/bundles/modernizr") %>
    </asp:PlaceHolder>
    <webopt:bundlereference runat="server" path="~/Content/css" />
    <%-- Chatbot styles live here so they always load, even if the Site.css bundle does not --%>
    <style>
        html, body { overflow-x: hidden; }

                .avuna-whatsapp {
            position: fixed;
            right: 20px;
            bottom: 20px;
            z-index: 9990;
            display: inline-flex;
            align-items: center;
            gap: 10px;
            padding: 13px 20px 13px 16px;
            background: #25D366;
            color: #ffffff !important;
            border-radius: 50px;
            font-family: var(--av-sans);
            font-size: 14px;
            font-weight: 700;
            text-decoration: none !important;
            box-shadow: 0 6px 18px rgba(0,0,0,.25);
            transition: transform .2s ease, background .2s ease;
        }
        .avuna-whatsapp:hover { background: #1ebe5a; transform: translateY(-3px); color: #ffffff !important; }
        .avuna-whatsapp svg { width: 24px; height: 24px; flex: none; }
        body.modal-open .avuna-whatsapp { display: none; }
        @media (max-width: 600px) { .avuna-whatsapp span { display: none; } .avuna-whatsapp { padding: 14px; } }
        @media print { .avuna-whatsapp { display: none !important; } }
    </style>
    <link href="~/favicon.ico" rel="shortcut icon" type="image/x-icon" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Playfair+Display:wght@500;600;700;800&display=swap" rel="stylesheet" />
<style>
/* =====================================================================
   AVUNA COLLECTIVE - shared theme
   Deep forest green, warm cream, bronze gold, serif headings.
   Loaded by Site.Master, Customer_master.Master and Manager_master.Master.
   ===================================================================== */
:root{
  --av-green:#0f2a1f;      /* navigation, primary buttons */
  --av-green-2:#173c2c;    /* hover */
  --av-green-3:#2c5a45;    /* soft accents */
  --av-cream:#f5efe6;      /* page background */
  --av-card:#fbf8f2;       /* cards */
  --av-line:#e5dccd;       /* hairlines */
  --av-sand:#e8dec9;       /* table header */
  --av-tan:#f2e2c9;        /* pills */
  --av-gold:#b98a3e;
  --av-bronze:#8a6a35;
  --av-ink:#1b2a22;
  --av-muted:#6c736d;
  --av-red:#9a3b33;
  --av-red-bg:#f4dcd7;
  --av-ok:#2f5a3a;
  --av-ok-bg:#dce6cf;
  --av-serif:"Playfair Display","Libre Baskerville",Georgia,"Times New Roman",serif;
  --av-sans:"Inter","Segoe UI",Roboto,Arial,sans-serif;
  --av-shadow:0 1px 2px rgba(31,42,34,.05),0 8px 24px rgba(31,42,34,.06);
}

html,body{overflow-x:hidden}
body{background:var(--av-cream);color:var(--av-ink);font-family:var(--av-sans);margin:0;-webkit-font-smoothing:antialiased}
h1,h2,h3,h4,h5,.av-serif{font-family:var(--av-serif);color:var(--av-green);letter-spacing:0;text-transform:none}
a{color:var(--av-bronze)}
a:hover{color:var(--av-green)}
.body-content{padding:0;max-width:none;margin:0}
body > form > .body-content,.body-content{padding-left:0;padding-right:0}
hr{display:none}

/* ---------- Navigation ---------- */
.av-nav{background:var(--av-green);padding:0;border-bottom:1px solid rgba(255,255,255,.06);position:relative;z-index:50}
.av-nav-inner{display:flex;align-items:center;gap:8px;max-width:1500px;margin:0 auto;padding:0 28px;min-height:66px}
.av-brand{display:flex;align-items:center;gap:12px;text-decoration:none!important;color:#fff!important;margin-right:26px;flex:none}
.av-brand img{width:52px;height:52px;border-radius:50%;background:#fff;border:2px solid var(--av-gold);object-fit:contain;display:block}
.av-brand span{font-family:var(--av-serif);font-size:25px;font-weight:600;color:#fff;white-space:nowrap;letter-spacing:.2px}
.av-brand small{display:block;font-family:var(--av-sans);font-size:10px;letter-spacing:2.2px;color:#cdb98f;font-weight:600;margin-top:1px}
.av-nav .navbar-collapse{flex-grow:1;align-items:center}
.av-links{display:flex;align-items:stretch;list-style:none;margin:0;padding:0;gap:2px;flex-wrap:wrap}
.av-links li{display:flex}
.av-link{display:flex;align-items:center;gap:9px;padding:0 17px;min-height:66px;color:#e9e4d8!important;text-decoration:none!important;font-size:15px;font-weight:500;border-bottom:3px solid transparent;transition:background .15s,color .15s;white-space:nowrap}
.av-link svg{display:none!important;width:19px;height:19px;stroke:currentColor;fill:none;stroke-width:1.6;stroke-linecap:round;stroke-linejoin:round;flex:none;opacity:.9}
.av-link:hover{background:rgba(255,255,255,.06);color:#fff!important}
.av-link.active{color:#fff!important;border-bottom-color:var(--av-gold);background:rgba(255,255,255,.05)}
.av-right{margin-left:auto;display:flex;align-items:center;gap:6px}
.av-right .av-link{border-bottom-color:transparent}
.av-btn-line{display:inline-flex;align-items:center;gap:8px;border:1px solid rgba(255,255,255,.35);color:#fff!important;border-radius:8px;padding:9px 18px;text-decoration:none!important;font-size:14px;font-weight:600;transition:all .15s}
.av-btn-line:hover{background:#fff;color:var(--av-green)!important}
.av-btn-gold{display:inline-flex;align-items:center;gap:8px;background:var(--av-gold);color:#fff!important;border-radius:8px;padding:9px 20px;text-decoration:none!important;font-size:14px;font-weight:700;border:1px solid var(--av-gold);transition:all .15s}
.av-btn-gold:hover{background:#a67a30;border-color:#a67a30}
.av-toggler{display:none;margin-left:auto;background:transparent;border:1px solid rgba(255,255,255,.35);border-radius:8px;padding:8px 10px;color:#fff;cursor:pointer}
.av-toggler svg{width:22px;height:22px;stroke:#fff;fill:none;stroke-width:2;stroke-linecap:round;display:block}
@media(max-width:1100px){
  .av-toggler{display:block}
  .av-nav-inner{flex-wrap:wrap;padding:8px 18px}
  .av-nav .navbar-collapse{width:100%;flex-basis:100%}
  .av-links{flex-direction:column;width:100%;padding:6px 0}
  .av-link{min-height:46px;border-bottom:0;border-left:3px solid transparent}
  .av-link.active{border-left-color:var(--av-gold)}
  .av-right{margin:6px 0 10px;flex-wrap:wrap}
}

/* ---------- Footer ---------- */
.av-footer{background:var(--av-green);color:#d9d2c0;margin-top:56px;padding:38px 28px 26px}
.av-footer-inner{max-width:1500px;margin:0 auto;display:flex;gap:40px;flex-wrap:wrap;align-items:flex-start;justify-content:space-between}
.av-footer .av-brand{margin:0}
.av-footer h4{font-family:var(--av-sans);font-size:11px;letter-spacing:2px;color:var(--av-gold);margin:0 0 10px;font-weight:700;text-transform:uppercase}
.av-footer p{margin:0;font-size:14px;line-height:1.7;color:#d9d2c0}
.av-footer a{color:#fff}
.av-footer-copy{max-width:1500px;margin:26px auto 0;padding-top:16px;border-top:1px solid rgba(255,255,255,.12);font-size:12.5px;color:#a9b3a9}

/* ---------- Page hero (photo banner, as in the mockups) ---------- */
.av-hero,.customer-hero,.avuna-manager-hero,.avuna-order .hero,.avuna-payment .hero,.avuna-hero,.pay-hero{
  position:relative;overflow:hidden;color:var(--av-ink)!important;
  background-color:#e9dfd0!important;
  background-image:linear-gradient(90deg,rgba(245,239,230,.98) 0%,rgba(245,239,230,.93) 36%,rgba(245,239,230,.55) 62%,rgba(245,239,230,0) 88%),var(--hero-img,url("images/avuna_collective_background.jpg"))!important;
  background-size:auto,var(--hero-size,2000px auto)!important;background-position:center,var(--hero-pos,right 33%)!important;background-repeat:no-repeat!important;
  border-radius:0;min-height:330px;padding:54px max(6%,40px)!important;display:flex;align-items:center;justify-content:flex-start!important;gap:20px;
}
.customer-hero:before,.customer-hero:after,.avuna-manager-hero:before,.avuna-manager-hero:after,.avuna-order .hero:before,.avuna-order .hero:after,.avuna-payment .hero:before,.avuna-payment .hero:after,.pay-hero:before,.pay-hero:after{display:none!important}
.customer-hero-badge,.av-logo-tile,.hero-mark,.hero-mark-logo,.avuna-order .hero-mark-logo{display:none!important}
.customer-hero h1,.avuna-manager-hero h1,.avuna-order .hero h1,.avuna-payment .hero h1,.pay-hero h1,.av-hero h1{font-family:var(--av-serif)!important;color:var(--av-green)!important;font-weight:800!important;letter-spacing:-.5px!important;font-size:clamp(34px,4.4vw,56px)!important;line-height:1.08!important;text-transform:none!important;margin:10px 0 14px!important}
.customer-hero p,.avuna-manager-hero p,.avuna-order .hero p,.avuna-payment .hero p,.pay-hero p,.av-hero p{color:#4c564f!important;font-size:17px!important;line-height:1.7!important;max-width:560px}
.customer-eyebrow,.eyebrow,.avuna-order .eyebrow,.avuna-manager-eyebrow,.hero-eyebrow{color:var(--av-bronze)!important;font-family:var(--av-sans);letter-spacing:3px!important;font-weight:700!important;font-size:11.5px!important;text-transform:uppercase}


/* hero secondary buttons + image framing */
.customer-hero .customer-btn-light,.avuna-manager-hero .avuna-button-outline,.avuna-order .hero a.back,.avuna-order .hero .hero-back,.avuna-order .hero a[href*="ustomerDashboard"],.avuna-payment .hero a[href*="ustomerDashboard"]{background:rgba(255,255,255,.55)!important;color:#0f2a1f!important;border:1px solid #0f2a1f!important}
.avuna-payment .hero{flex-direction:column;align-items:flex-start!important;justify-content:center}
.avuna-payment .hero .tag{color:#8a6a35!important;background:none!important;padding:0!important}
/* ---------- Buttons ---------- */
.av-btn,.customer-btn,.customer-btn-orange,.avuna-order .submit,.avuna-order .back{border-radius:8px}
.btn-primary,.av-btn-primary{background:var(--av-green);border-color:var(--av-green);color:#fff}
.btn-primary:hover,.av-btn-primary:hover{background:var(--av-green-2);border-color:var(--av-green-2)}

/* ---------- Chatbot ---------- */
#chatToggle{border-color:var(--av-gold)!important}
.chat-header{background:var(--av-green)!important;font-family:var(--av-serif)}
.chat-header strong{font-family:var(--av-serif);font-size:17px;font-weight:600}
.user-message{background:var(--av-green)!important}
.bot-message{background:#e9e2d2!important}
.chat-input-area button{background:var(--av-green)!important}

@media(min-width:1101px){.av-nav .navbar-collapse{display:flex!important;flex-basis:auto}}

/* ---------- Footer: social links ---------- */
.av-social{list-style:none;margin:0;padding:0;display:flex;flex-direction:column;gap:9px}
.av-social a{display:inline-flex;align-items:center;gap:11px;color:#e9e4d8!important;text-decoration:none!important;font-size:14px;transition:color .15s}
.av-social a:hover{color:#fff!important}
.av-social svg{width:34px;height:34px;padding:8px;border:1px solid rgba(255,255,255,.28);border-radius:50%;stroke:currentColor;fill:none;stroke-width:1.6;stroke-linecap:round;stroke-linejoin:round;flex:none;transition:all .15s}
.av-social a:hover svg{background:var(--av-gold);border-color:var(--av-gold);color:#fff}

</style>
